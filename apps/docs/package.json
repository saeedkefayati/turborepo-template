{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docusaurus start --port 3001 --no-open",
    "build": "docusaurus build",
    "start": "docusaurus start --port 3001 --no-open",
    "serve": "docusaurus serve --port 3001",
    "clear": "docusaurus clear",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:mdx": "remark \"content/**/*.mdx\" --ext mdx --output --quiet && pnpm check:mdx",
    "check:mdx": "remark \"content/**/*.mdx\" --ext mdx --no-stdout --frail",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "catalog:",
    "prism-react-renderer": "^2.3.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@repo/eslint-config": "workspace:*",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "remark-cli": "^12.0.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "typescript": "catalog:"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}

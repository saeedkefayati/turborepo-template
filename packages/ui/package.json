{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles/index.css",
    "./*": "./src/components/*/index.ts"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --exact-port --no-open",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --exact-port",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project=storybook"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "^10.5.7",
    "playwright": "latest",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vite": "^8.2.1",
    "vitest": "latest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0"
  }
}

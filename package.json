{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write . && pnpm --filter docs format:mdx",
    "format:check": "prettier --check . && pnpm --filter docs check:mdx",
    "check-types": "turbo run check-types",
    "commit": "git-cz",
    "branch": "node scripts/git/branch.mjs",
    "branch:validate": "node scripts/git/validate-branch.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@inquirer/prompts": "^8.5.2",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.2",
    "globals": "^16.5.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
